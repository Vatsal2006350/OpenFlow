{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenFlow",
  "version": "0.2.2",
  "identifier": "com.openflow.openflow",
  "build": {
    "beforeDevCommand": {
      "script": "jac build main.jac --client web",
      "cwd": "../jac",
      "wait": true
    },
    "beforeBuildCommand": {
      "script": "jac build main.jac --client web",
      "cwd": "../jac"
    },
    "frontendDist": "../jac/.jac/client/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "Entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
